# Ignore everything by default.
/*

# Keep repository configuration.
!/.gitignore
!/Cargo.toml
!/Cargo.lock
!/compose.yaml
!/README.md
!/goal-and-requirements.md
!/architecture.md
!/cookie_bridge/
!/cookie_bridge/**
/cookie_bridge/__pycache__/
/cookie_bridge/*.pyc

# Keep source files.
!/src/
!/src/**

# Keep GitHub workflows.
!/.github/
!/.github/**
